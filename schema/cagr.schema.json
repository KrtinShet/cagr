		"rules": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"dirs": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Folders holding rule files (*.yml): code rules and layout rules."
				}
			},
			"description": "Custom code rules."
		},
		"review": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"enabled": {
					"type": "boolean",
					"description": "Gate pull requests on a review by a reviewer agent in a fresh context."
				},
				"gate": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Commands that need a passing review of the current commit, matched like [commands] blocked."
				},
				"reviewer": {
					"type": "string",
					"minLength": 1,
					"description": "\"auto\", \"claude\", \"codex\", or a command. A command gets {prompt_file} and {schema_file} and prints the findings as JSON."
				},
				"model": {
					"type": "string",
					"description": "Model for the reviewer agent, if not its default."
				},
				"guide": {
					"type": "string",
					"description": "The repo's review instructions, read into every review. Default: .cagr/review.md, or REVIEW.md when only that exists. Missing is fine."
				},
				"effort": {
					"type": "string",
					"enum": [
						"quick",
						"standard",
						"deep"
					],
					"description": "quick: one finder. standard: a bug finder, a security finder and a verifier. deep: three finders and three voting verifiers. High-risk changes always get deep."
				},
				"security": {
					"type": "boolean",
					"description": "Run a security finder in standard and deep reviews."
				},
				"max_rounds": {
					"type": "integer",
					"minimum": 1,
					"description": "After this many rounds the reviewer asks the author to step back and rethink the approach."
				},
				"timeout_seconds": {
					"type": "integer",
					"minimum": 30,
					"description": "How long one reviewer agent may run."
				},
				"skip": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Globs the reviewer does not review."
				},
				"pr_sections": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Headings a pull request body must have. `gh pr create` without them is denied."
				},
				"agents_may_merge": {
					"type": "boolean",
					"description": "Let agents run `gh pr merge` and `gh pr review --approve`. Off: approval stays with a person."
				},
				"status": {
					"type": "boolean",
					"description": "Report to GitHub without a workflow: `cagr review` sets the commit status cagr/review, and the pre-push hook sets cagr/checks after its commands pass. Needs `gh`."
				}
			},
			"description": "The review gate and the reviewer agent."
		},
		"risk": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default": {
					"type": "string",
					"enum": [
						"low",
						"medium",
						"high"
					],
					"description": "Tier of a file no [[risk.paths]] entry matches."
				},
				"paths": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"glob": {
								"type": "string",
								"minLength": 1,
