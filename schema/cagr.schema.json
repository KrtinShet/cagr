																},
																"required": [
																	"path",
																	"status"
																]
															}
														}
													},
													"required": [
														"changes"
													]
												}
											}
										},
										"required": [
											"valid",
											"invalid"
										]
									},
									"kind": {
										"type": "string",
										"enum": [
											"requires"
										]
									},
									"require": {
										"type": "array",
										"items": {
											"type": "string",
											"minLength": 1
										}
									}
								},
								"required": [
									"id",
									"kind",
									"paths",
									"reason",
									"examples",
									"require"
								]
							},
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"id": {
										"type": "string",
										"minLength": 1
									},
									"paths": {
										"type": "array",
										"items": {
											"type": "string",
											"minLength": 1
										}
									},
									"ignores": {
										"type": "array",
										"items": {
