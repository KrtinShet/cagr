										}
									},
									"reason": {
										"type": "string",
										"minLength": 1
									},
									"note": {
										"type": "string"
									},
									"examples": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"valid": {
												"type": "array",
												"items": {
													"type": "object",
													"additionalProperties": false,
													"properties": {
														"changes": {
															"type": "array",
															"items": {
																"type": "object",
																"additionalProperties": false,
																"properties": {
																	"path": {
																		"type": "string",
																		"minLength": 1
																	},
																	"status": {
																		"type": "string",
																		"enum": [
																			"A",
																			"M",
																			"D",
																			"T"
																		]
																	},
																	"before": {
																		"type": "string"
																	},
																	"after": {
																		"type": "string"
																	}
																},
																"required": [
																	"path",
																	"status"
																]
															}
														}
													},
													"required": [
														"changes"
													]
												}
											},
											"invalid": {
												"type": "array",
												"items": {
													"type": "object",
													"additionalProperties": false,
													"properties": {
														"changes": {
															"type": "array",
															"items": {
																"type": "object",
