{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$(git rev-parse --show-toplevel)\"/src/cli.ts hook session.start --agent codex",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$(git rev-parse --show-toplevel)\"/src/cli.ts hook command.before --agent codex",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "^(apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$(git rev-parse --show-toplevel)\"/src/cli.ts hook file.before_edit --agent codex",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(apply_patch|Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$(git rev-parse --show-toplevel)\"/src/cli.ts hook file.after_edit --agent codex",
						"timeout": 60
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$(git rev-parse --show-toplevel)\"/src/cli.ts hook turn.end --agent codex",
						"timeout": 300
					}
				]
			}
		]
	}
}
