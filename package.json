{
	"name": "cagr-dev",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"cagr": "bun src/cli.ts",
		"test": "bun test src",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check-types": "tsc --noEmit",
		"schema": "bun src/cli.ts schema > schema/cagr.schema.json",
		"build": "bun scripts/build.ts",
		"package": "bun scripts/package.ts",
		"e2e": "bun scripts/e2e.ts",
		"verify": "bun run lint && bun run check-types && bun run test"
	},
	"dependencies": {
		"@ast-grep/lang-go": "^0.0.6",
		"@ast-grep/lang-python": "^0.0.6",
		"@ast-grep/lang-rust": "^0.0.7",
		"@ast-grep/napi": "^0.51.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
